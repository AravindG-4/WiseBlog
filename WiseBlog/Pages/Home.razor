@page "/"
@using WiseBlog.Services
@inject AuthenticationStateProvider Auth

<PageTitle>Home</PageTitle>
<h1>Hello, world!</h1>
<AuthorizeView>
    <Authorized>
        <p>Hello, @authuser.name !</p>
    </Authorized>
    <NotAuthorized>
        <p>You're not authenticated</p>
    </NotAuthorized>
</AuthorizeView>

Welcome to your new app.

@code {
    User? authuser;
    protected override void OnInitialized()
    {
        authuser = ((AuthenticationProvider)Auth).User;
    }
}