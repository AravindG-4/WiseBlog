@page "/img"
<h3>Image Test</h3>

<img src="@imageDataUrl" alt="Profile Picture" class="profile-picture" />

<style>
    .profile-picture {
        width: 50px; /* Adjust the size as needed */
        height: 50px; /* Make it a square */
        border-radius: 50%; /* Make it circular */
        object-fit: cover; /* Ensure the image fits within the circle */
        border: 2px solid #ddd; /* Optional: Add a border */
        box-shadow: 0 0 5px rgba(0, 0, 0, 0.2); /* Optional: Add a shadow */
    }
</style>

@code {
    string imageString = "";
    string imageDataUrl = "";

    protected override void OnInitialized()
    {
        // Create a data URL for the image
        imageDataUrl = $"data:image/png;base64,{imageString}"; // Replace "png" with the appropriate format
    }
}
